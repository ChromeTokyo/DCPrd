# 复制为 .env 后填写。生产环境的 .env 只存在于服务器，切勿提交到仓库。
DOMAIN=dcpm.ddns.net
TG_BOT_TOKEN=123456:REPLACE_ME
TG_BOT_USERNAME=dcprd_bot
JIRA_BASE_URL=https://dcjira.opscom666.com/jira
# 为空则首次启动自动生成到 $DATA_DIR/secret_key
SECRET_KEY=
MAX_UPLOAD_MB=300
TIMEZONE=Asia/Tokyo
DATA_DIR=/data
# 本地开发设为 1：允许非 Secure Cookie、base_url 使用 http
DEV_MODE=0
